{
	"name": "disaster-evolution",
	"servePort": 34874,
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"Shared": {
				"$path": "src/shared"
			},
			"SkillAssets": {
				"$path": "assets/skills"
			},
			"PlaceRole": {
				"$className": "StringValue",
				"$properties": {
					"Value": "Run"
				}
			}
		},
		"ServerScriptService": {
			"Server": {
				"$path": "src/server"
			}
		},
		"StarterPlayer": {
			"$properties": {
				"CharacterUseJumpPower": true,
				"CharacterJumpPower": 0,
				"DevCameraOcclusionMode": "Zoom"
			},
			"StarterPlayerScripts": {
				"Client": {
					"$path": "src/client"
				},
				"RbxCharacterSounds": {
					"$path": "src/overrides/RbxCharacterSounds.client.luau"
				}
			}
		},
		"Workspace": {
			"$properties": {
				"StreamingEnabled": false
			}
		}
	}
}
