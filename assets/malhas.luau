local BREEZE_PALETTE = "rbxassetid://72546102315692"

local function load(id: number): MeshPart?
	local ok, part = pcall(function()
		return AssetService:CreateMeshPartAsync(Content.fromUri("rbxassetid://" .. id))
	end)
	if ok then
		return part
	end
	warn("malha", id, part)
	return nil
end

local made, failed = 0, 0
local folder = ReplicatedStorage:FindFirstChild("Assets")
if not folder then
	folder = Instance.new("Folder")
	folder.Name = "Assets"
	folder.Parent = ReplicatedStorage
end
for name, id in CITY do
	if not folder:FindFirstChild(name) then
		local part = load(id)
		if part then
			part.Name = name
			part.Anchored = true
			part.Parent = folder
			made += 1
		else
			failed += 1
		end
	end
end
-- um task.spawn por modelo: em fila, quase 700 malhas demoram demais
local pending = 0
for _, model in ReplicatedStorage.SkillAssets:GetChildren() do
	local ids = SKILLS[model.Name]
	if not ids then
		warn("modelo sem malhas na lista", model.Name)
		continue
	end
	pending += 1
	task.spawn(function()
		for _, part in model:GetDescendants() do
			if part:IsA("MeshPart") then
				if part.MeshId == "" then
					local size = part.Size
					local id = ids[part.Name]
					local mesh = id and load(id)
					if mesh then
						part:ApplyMesh(mesh)
						part.Size = size
						made += 1
					else
						failed += 1
					end
				end
				if model.Name == "Breeze" then
					part.TextureID = BREEZE_PALETTE
				end
			end
		end
		pending -= 1
	end)
end
while pending > 0 do
	task.wait()
end
print(`malhas: {made} criadas, {failed} falharam. Agora salve o place (Ctrl+S).`)
